{"C0800":{"d":"Das Fahrwerks-Steuergerät hat erkannt, dass die Versorgungsspannung unter dem Betriebsschwellwert für ABS, ESP oder Lenkungsysteme liegt. Viele Fahrwerksfunktionen werden eingeschränkt oder deaktiviert, bis die Spannung wieder im Normalbereich liegt.","h":[0.3,3],"q":["https://en.wikipedia.org/wiki/On-board_diagnostics"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Bordnetzspannung niedrig","u":[["hoch","Batterie schwach oder entladen"],["mittel","Generator-Ladefehler"],["niedrig","Hochohmige Masse- oder Versorgungsverbindung"]]},"C0805":{"d":"Das Fahrwerks- oder ESP-Steuergerät meldet, dass der Lenkwinkelsensor nicht kalibriert ist oder die Kalibrierdaten verloren wurden. ESP benötigt eine kalibrierte Nulllage und ist bis zur Kalibrierung deaktiviert.","h":[0.2,1],"q":["https://en.wikipedia.org/wiki/Electronic_stability_control"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"leicht","t":"Lenkwinkelsensor Kalibrierung","u":[["hoch","Kalibrierung nach Batterietrennung oder Reparatur erforderlich"],["mittel","Sensor hat Kalibrierdaten verloren"],["niedrig","Achsvermessung fehlerhaft, blockiert Kalibrierung"]]},"C0810":{"d":"Der Stromkreis des Luftfederungs-Kompressormotors meldet einen elektrischen Fehler. Die Niveauregulierung wird deaktiviert.","h":[1.5,5],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"schwer","t":"Luftfederung Kompressor Stromkreis","u":[["hoch","Kompressormotor defekt"],["mittel","Kompressorrelais defekt"]]},"C0815":{"d":"Der Luftfederungs-Kompressor wurde zum Schutz vor Ueberhitzung deaktiviert; meist nach einer langsamen Leckage.","h":[1,6],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"schwer","t":"Luftfederung Kompressor Uebertemperatur","u":[["hoch","Langsame Leckage an Luftfeder oder Leitung"],["mittel","Kompressor verschlissen"]]},"C0820":{"d":"Der Hoehensensor vorne links meldet ein unplausibles oder fehlendes Signal.","h":[0.5,2],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Luftfederungs-Hoehensensor vorne links","u":[["hoch","Sensorgestaenge gebrochen"],["mittel","Sensor defekt"]]},"C0821":{"d":"Der Hoehensensor vorne rechts meldet ein unplausibles oder fehlendes Signal.","h":[0.5,2],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Luftfederungs-Hoehensensor vorne rechts","u":[["hoch","Sensorgestaenge gebrochen"],["mittel","Sensor defekt"]]},"C0822":{"d":"Der Hoehensensor hinten links meldet ein unplausibles oder fehlendes Signal.","h":[0.5,2],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Luftfederungs-Hoehensensor hinten links","u":[["hoch","Sensorgestaenge gebrochen"],["mittel","Sensor defekt"]]},"C0823":{"d":"Der Hoehensensor hinten rechts meldet ein unplausibles oder fehlendes Signal.","h":[0.5,2],"q":["https://en.wikipedia.org/wiki/Air_suspension"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Luftfederungs-Hoehensensor hinten rechts","u":[["hoch","Sensorgestaenge gebrochen"],["mittel","Sensor defekt"]]},"C0825":{"d":"Das Lenkungssteuergerät hat erkannt, dass das Signal des Lenkmoment-Sensors außerhalb des erwarteten Bereichs liegt. Die Lenkunterstützung wird reduziert oder deaktiviert.","h":[1,4],"q":["https://en.wikipedia.org/wiki/Power_steering"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"schwer","t":"Lenkmoment-Sensor Bereich/Leistung","u":[["hoch","Lenkmoment-Sensor defekt"],["mittel","Kalibrierung nach Service erforderlich"],["niedrig","Sensorelement gealtert über Kalibrierfenster hinaus"]]},"C0827":{"d":"Das Lenkungssteuergerät hat erkannt, dass sich das Signal des Lenkmoment-Sensors trotz Lenkbewegung nicht ändert — der Sensor scheint zu klemmen. Die Lenkunterstützung wird zur Vermeidung unkontrollierter Lenkmomente deaktiviert.","h":[1,4],"q":["https://en.wikipedia.org/wiki/Power_steering"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"schwer","t":"Lenkmoment-Sensor blockiert","u":[["hoch","Sensor mechanisch blockiert"],["mittel","Sensorelektronik defekt"]]},"C0830":{"d":"Das Fahrwerk-Steuergerät hat keine gültige Mittelstellung (Nullpunkt) des Lenkwinkelsensors hinterlegt. ESP, Spurhalte- und elektrische Lenkunterstützung können bis zur Kalibrierung eingeschränkt sein.","h":[0.3,1.5],"q":["https://en.wikipedia.org/wiki/Electronic_stability_control"],"s":["ABS-Warnleuchte an","ESP/Stabilitätskontrolle deaktiviert","Möglicherweise reduzierte Bremskraftunterstützung","Tachometer kann sich auffällig verhalten"],"sw":"mittel","t":"Lenkwinkelsensor Mittelstellung nicht angelernt","u":[["hoch","Sensorkalibrierung nach Austausc